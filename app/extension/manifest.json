{
  "manifest_version": 3,
  "name": "Lube Studio · Flow 桥接助手",
  "version": "2.0.0",
  "description": "Lube Studio 本地私有桥接扩展 — 在已登录的 flow.google.com 标签页内安全转发影视分镜与视频生成请求。",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://www.midjourney.com/*",
    "https://cdn.midjourney.com/*",
    "https://muse.ai/*",
    "http://127.0.0.1:8434/*",
    "http://localhost:8434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lube Studio · Flow 桥接助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flowboard_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
